<?xml version="1.0" encoding="utf-8"?>
<!-- ShopPOS splash / launch screen background (API 21+).
     Shows the logo centred on a white background so the icon
     is always clearly visible while Flutter initialises. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- White background — matches the logo's own background -->
    <item android:drawable="@android:color/white" />

    <!-- Centred logo bitmap -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>

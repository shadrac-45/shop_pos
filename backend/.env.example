# Copy to .env (never commit it) or set these in your host's dashboard.

# Port the server listens on.
PORT=3000

# Paystack secret key: sk_test_... while testing, sk_live_... in production.
# Leave empty to run sync only (Mobile Money disabled).
PAYSTACK_SECRET_KEY=

# Long random secret. Enter the same value in the app under
# Settings → Integrations → API key. Required for cloud sync.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=

# Where synced shop data is stored (a JSON file). Back this folder up.
DATA_DIR=./data
